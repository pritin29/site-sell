* { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #0a1628;
  color: #fff;
  min-height: 100vh;
  padding: 20px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 30px;
  margin-bottom: 20px;
}

.logo { font-size: 32px; font-weight: 700; color: #00e5ff; letter-spacing: 2px; }

.auth-buttons { display: flex; gap: 12px; }

.btn-auth {
  padding: 10px 24px;
  border: none;
  border-radius: 8px;
  background: #00e5ff;
  color: #0a1628;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}
.btn-auth:hover { background: #00b8d4; }

/* Навигация */
.nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 30px;
}

.nav-btn {
  padding: 18px 30px;
  border: none;
  border-radius: 12px;
  background: #00c853;
  color: #0a1628;
  font-size: 20px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  transition: all 0.2s;
}
.nav-btn:hover { background: #00e676; transform: translateY(-2px); }
.nav-btn.active { background: #00e676; box-shadow: 0 4px 15px rgba(0,230,118,0.4); }

.info-circle {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: #1565c0;
  color: #fff;
  font-size: 18px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
}
.info-circle:hover { background: #1976d2; transform: scale(1.1); }

/* Страницы */
.page { animation: fade 0.3s ease; }
@keyframes fade { from{opacity:0;transform:translateY(10px);} to{opacity:1;transform:translateY(0);} }

.page-header {
  background: #00e5ff;
  padding: 25px 30px;
  border-radius: 12px;
  margin-bottom: 25px;
}
.page-header h2 { color: #0a1628; font-size: 26px; margin-bottom: 6px; }
.page-header p { color: #0a1628; font-size: 15px; opacity: 0.8; }

/* Сетка */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}

/* Карточки */
.card {
  background: #112240;
  border: 2px solid #1a3a5c;
  border-radius: 12px;
  padding: 25px;
  transition: transform 0.2s, border-color 0.2s;
}
.card:hover { transform: translateY(-4px); border-color: #00e5ff; }

.avatar {
  width: 80px; height: 80px;
  border-radius: 50%;
  margin: 0 auto 15px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; font-weight: 700; color: #fff;
}
.avatar.small { width: 55px; height: 55px; font-size: 18px; margin: 0; }

.employee-card { text-align: center; }
.employee-card h3 { color: #00e5ff; font-size: 18px; margin-bottom: 8px; }
.role { color: #76ff03; font-size: 14px; font-weight: 600; margin-bottom: 12px; }
.desc { color: #b0bec5; font-size: 14px; line-height: 1.5; margin-bottom: 12px; }
.phone { color: #fff; font-size: 14px; margin-bottom: 15px; }

.deliveries {
  text-align: left;
  background: #0d2137;
  border-radius: 8px;
  padding: 12px 15px;
  margin-top: 10px;
}
.deliveries h4 { color: #ffeb3b; font-size: 13px; margin-bottom: 8px; }
.deliveries ul { list-style: none; }
.deliveries li {
  color: #e0e0e0;
  font-size: 12px;
  line-height: 1.6;
  padding: 4px 0;
  border-bottom: 1px solid #1a3a5c;
}
.deliveries li:last-child { border-bottom: none; }

/* Карта */
.map-wrap { margin-bottom: 20px; }
.map-svg { width: 100%; border-radius: 12px; border: 2px solid #1a3a5c; }

.stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}
.stat {
  background: #ccff00;
  color: #0a1628;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
}
.stat:hover { transform: translateY(-4px); }
.stat-icon { font-size: 36px; margin-bottom: 10px; }
.stat-lbl { font-size: 14px; font-weight: 600; opacity: 0.8; margin-bottom: 8px; }
.stat-val { font-size: 24px; font-weight: 800; }

/* Таблица */
.table-wrap {
  background: #112240;
  border: 2px solid #1a3a5c;
  border-radius: 12px;
  padding: 25px;
  overflow-x: auto;
}
.table-wrap h3 { color: #00e5ff; font-size: 20px; margin-bottom: 15px; }
.routes-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.routes-table th {
  background: #0d2137;
  color: #76ff03;
  padding: 12px 10px;
  text-align: left;
  border-bottom: 2px solid #1a3a5c;
}
.routes-table td {
  padding: 10px;
  color: #e0e0e0;
  border-bottom: 1px solid #1a3a5c;
}
.routes-table tr:hover td { background: #0d2137; }

/* Клиенты */
.client-head { display: flex; align-items: center; gap: 15px; margin-bottom: 12px; }
.client-head h3 { color: #00e5ff; font-size: 17px; }
.city { color: #b0bec5; font-size: 13px; margin-top: 3px; }
.rating { color: #ffeb3b; font-size: 18px; margin-bottom: 10px; letter-spacing: 2px; }
.review { color: #e0e0e0; font-size: 14px; line-height: 1.6; font-style: italic; margin-bottom: 12px; }
.date { color: #78909c; font-size: 12px; text-align: right; }

/* Модалка */
.modal-bg {
  position: fixed;
  top:0; left:0;
  width:100%; height:100%;
  background: rgba(10,22,40,0.85);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}
.modal-bg.show { display: flex; }

.modal {
  background: #112240;
  border: 2px solid #00e5ff;
  border-radius: 16px;
  padding: 35px;
  max-width: 700px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
}
.modal-x {
  position: absolute;
  top: 15px; right: 20px;
  background: none; border: none;
  color: #fff; font-size: 24px;
  cursor: pointer;
}
.modal-x:hover { color: #ff5252; }

.modal h2 { color: #00e5ff; font-size: 26px; margin-bottom: 25px; padding-bottom: 12px; border-bottom: 2px solid #1a3a5c; }
.info-block { margin-bottom: 25px; }
.info-block h3 { color: #76ff03; font-size: 18px; margin-bottom: 12px; }
.info-block p { color: #e0e0e0; font-size: 14px; line-height: 1.7; margin-bottom: 8px; }

.c-review {
  background: #0d2137;
  border-left: 3px solid #00e5ff;
  padding: 15px;
  border-radius: 6px;
  margin-bottom: 12px;
}
.c-review b { color: #00e5ff; }
.c-review .stars { color: #ffeb3b; margin-left: 8px; }
.c-review p { margin-top: 8px; font-style: italic; }

@media (max-width: 768px) {
  .header { flex-direction: column; gap: 15px; text-align: center; }
  .nav { grid-template-columns: 1fr; }
  .grid { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); }
}
