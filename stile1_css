* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background: #0a1628;
    color: #fff;
    min-height: 100vh;
}

/* ШАПКА */
.header {
    background: linear-gradient(135deg, #0a2540 0%, #0d3b66 100%);
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px solid #00d4aa;
}

.logo {
    font-size: 32px;
    font-weight: 900;
    color: #00d4aa;
    letter-spacing: 2px;
}

.auth-buttons {
    display: flex;
    gap: 15px;
}

.btn {
    padding: 12px 30px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-login {
    background: #00d4aa;
    color: #0a2540;
}

.btn-login:hover {
    background: #00ffcc;
    transform: translateY(-2px);
}

.btn-register {
    background: transparent;
    color: #00d4aa;
    border: 2px solid #00d4aa;
}

.btn-register:hover {
    background: #00d4aa;
    color: #0a2540;
}

/* НАВИГАЦИЯ */
.main-nav {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 30px 20px;
    background: #0d2137;
}

.nav-btn {
    flex: 1;
    max-width: 300px;
    padding: 20px;
    background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
    color: #0a2540;
    border: none;
    border-radius: 12px;
    font-size: 20px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
}

.nav-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 212, 170, 0.4);
}

.nav-btn.active {
    background: linear-gradient(135deg, #00ffcc 0%, #00d4aa 100%);
    box-shadow: 0 5px 20px rgba(0, 212, 170, 0.5);
}

/* КНОПКА КОМПАНИИ */
.company-btn-wrapper {
    display: flex;
    justify-content: center;
    padding: 20px;
}

.company-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 40px;
    background: linear-gradient(135deg, #1a5f4a 0%, #00d4aa 100%);
    color: #fff;
    border: 2px solid #00ffcc;
    border-radius: 50px;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.company-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(0, 212, 170, 0.5);
}

.company-icon {
    font-size: 24px;
}

/* ВКЛАДКИ */
.tab-content {
    display: none;
    padding: 40px;
    max-width: 1400px;
    margin: 0 auto;
}

.tab-content.active {
    display: block;
    animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.tab-content h2 {
    color: #00d4aa;
    font-size: 28px;
    margin-bottom: 25px;
    border-left: 5px solid #00d4aa;
    padding-left: 15px;
}

/* ПАНЕЛЬ СОТРУДНИКОВ */
.employee-actions {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.btn-action {
    padding: 12px 25px;
    background: linear-gradient(135deg, #00d4aa, #00b894);
    color: #0a2540;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 20px rgba(0, 212, 170, 0.4);
}

.employee-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.employee-card {
    background: linear-gradient(135deg, #0d3b66 0%, #1a5f4a 100%);
    border: 2px solid #00d4aa;
    border-radius: 12px;
    padding: 20px;
    transition: all 0.3s;
}

.employee-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 212, 170, 0.3);
}

.employee-card h4 {
    color: #00ffcc;
    font-size: 18px;
    margin-bottom: 10px;
}

.employee-card p {
    color: #b0c4de;
    font-size: 14px;
    margin-bottom: 5px;
}

.employee-status {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    margin-top: 10px;
}

.status-free {
    background: #00d4aa;
    color: #0a2540;
}

.status-busy {
    background: #ff6b35;
    color: #fff;
}

.status-vacation {
    background: #6c757d;
    color: #fff;
}

/* ДОСКА ЗАДАЧ */
.task-board {
    background: #0d2137;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #1a5f4a;
}

.task-board h3 {
    color: #00d4aa;
    margin-bottom: 20px;
}

.task-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.task-column {
    background: #0a1628;
    border-radius: 10px;
    padding: 15px;
    min-height: 200px;
}

.task-column h4 {
    color: #fff;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid #1a5f4a;
}

.task-item {
    background: #1a5f4a;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.task-item:hover {
    background: #00d4aa;
    color: #0a2540;
}

/* КАРТА */
.map-container {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
    background: #0d2137;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #1a5f4a;
}

.map-svg {
    background: #0a1628;
    border-radius: 10px;
    overflow: hidden;
}

.map-svg svg {
    width: 100%;
    height: auto;
}

.city {
    cursor: pointer;
    transition: all 0.3s;
}

.city:hover {
    r: 12;
    fill: #ff6b35;
}

.route-info {
    background: #0a1628;
    border-radius: 10px;
    padding: 20px;
}

.route-info h3 {
    color: #00d4aa;
    margin-bottom: 20px;
}

.route-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.route-form label {
    color: #b0c4de;
    font-size: 14px;
}

.route-form select {
    padding: 10px;
    background: #0d3b66;
    color: #fff;
    border: 1px solid #00d4aa;
    border-radius: 6px;
    font-size: 14px;
}

.btn-calculate {
    padding: 12px;
    background: #00d4aa;
    color: #0a2540;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 10px;
}

.btn-calculate:hover {
    background: #00ffcc;
}

.btn-clear {
    padding: 10px;
    background: transparent;
    color: #ff6b35;
    border: 2px solid #ff6b35;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    margin-top: 10px;
}

.btn-clear:hover {
    background: #ff6b35;
    color: #fff;
}

.route-result {
    margin-top: 20px;
    padding: 15px;
    background: #1a5f4a;
    border-radius: 8px;
}

.result-item {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid #0d3b66;
}

.result-item:last-child {
    border-bottom: none;
}

.result-item span {
    color: #b0c4de;
}

.result-item strong {
    color: #00ffcc;
    font-size: 16px;
}

/* КЛИЕНТЫ */
.clients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.client-card {
    background: linear-gradient(135deg, #0d3b66 0%, #1a5f4a 100%);
    border: 2px solid #00d4aa;
    border-radius: 12px;
    padding: 20px;
    transition: all 0.3s;
}

.client-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 212, 170, 0.3);
}

.client-card h4 {
    color: #00ffcc;
    font-size: 18px;
    margin-bottom: 10px;
}

.client-card .client-desc {
    color: #b0c4de;
    font-size: 14px;
    margin-bottom: 15px;
    line-height: 1.5;
}

.client-rating {
    color: #ffd700;
    font-size: 18px;
}

.reviews-section {
    background: #0d2137;
    border-radius: 12px;
    padding: 25px;
    border: 1px solid #1a5f4a;
}

.reviews-section h3 {
    color: #00d4aa;
    margin-bottom: 20px;
}

.review-item {
    background: #0a1628;
    border-left: 4px solid #00d4aa;
    padding: 15px 20px;
    margin-bottom: 15px;
    border-radius: 0 8px 8px 0;
}

.review-item .review-author {
    color: #00ffcc;
    font-weight: 600;
    margin-bottom: 5px;
}

.review-item .review-text {
    color: #b0c4de;
    font-size: 14px;
    line-height: 1.5;
}

.review-item .review-date {
    color: #6c757d;
    font-size: 12px;
    margin-top: 8px;
}

/* КАЛЬКУЛЯТОР FAB */
.calculator-fab {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #00d4aa, #00ffcc);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 5px 20px rgba(0, 212, 170, 0.5);
    transition: all 0.3s;
    z-index: 100;
}

.calculator-fab:hover {
    transform: scale(1.1);
}

/* МОДАЛЬНЫЕ ОКНА */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: linear-gradient(135deg, #0d3b66 0%, #1a5f4a 100%);
    border: 2px solid #00d4aa;
    border-radius: 16px;
    padding: 30px;
    max-width: 500px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    position: relative;
}

.modal-content h3 {
    color: #00ffcc;
    margin-bottom: 20px;
    font-size: 22px;
}

.modal-content label {
    display: block;
    color: #b0c4de;
    margin-bottom: 5px;
    margin-top: 15px;
}

.modal-content input,
.modal-content select,
.modal-content textarea {
    width: 100%;
    padding: 10px;
    background: #0a1628;
    color: #fff;
    border: 1px solid #00d4aa;
    border-radius: 6px;
    font-size: 14px;
}

.modal-content textarea {
    min-height: 80px;
    resize: vertical;
}

.modal-content .btn-submit {
    width: 100%;
    padding: 12px;
    background: #00d4aa;
    color: #0a2540;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    margin-top: 20px;
}

.modal-content .btn-submit:hover {
    background: #00ffcc;
}

.close-btn {
    position: absolute;
    top: 15px;
    right: 15px;
    background: transparent;
    border: none;
    color: #ff6b35;
    font-size: 24px;
    cursor: pointer;
}

/* КАЛЬКУЛЯТОР МОДАЛКА */
.calculator-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.calculator-modal.active {
    display: flex;
}

.calculator-content {
    background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
    border-radius: 16px;
    padding: 30px;
    max-width: 400px;
    width: 90%;
    position: relative;
    color: #0a2540;
}

.calculator-content h2 {
    color: #0a2540;
    margin-bottom: 20px;
}

.calc-form label {
    display: block;
    color: #0a2540;
    font-weight: 600;
    margin-top: 10px;
}

.calc-form input,
.calc-form select {
    width: 100%;
    padding: 10px;
    background: #fff;
    color: #0a2540;
    border: 2px solid #0a2540;
    border-radius: 6px;
    font-size: 14px;
    margin-bottom: 10px;
}

.calc-result {
    background: #b8ff00;
    padding: 20px;
    border-radius: 10px;
    margin-top: 20px;
}

.price-display {
    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
}

.price-display strong {
    font-size: 32px;
    font-weight: 900;
    color: #0a2540;
}

.calc-details {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: #0a2540;
    margin-bottom: 15px;
}

.btn-order {
    width: 100%;
    padding: 12px;
    background: #0047ab;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
}

.btn-order:hover {
    background: #003d99;
}

/* АДАПТИВНОСТЬ */
@media (max-width: 768px) {
    .header {
        flex-direction: column;
        gap: 15px;
        padding: 15px;
    }

    .main-nav {
        flex-direction: column;
        align-items: center;
    }

    .nav-btn {
        max-width: 100%;
    }

    .map-container {
        grid-template-columns: 1fr;
    }

    .task-columns {
        grid-template-columns: 1fr;
    }

    .tab-content {
        padding: 20px;
    }
}
