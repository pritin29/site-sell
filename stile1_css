/* ===== СБРОС И БАЗОВЫЕ СТИЛИ ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #0a1628;
  color: #fff;
  min-height: 100vh;
  padding: 20px;
}

/* ===== ШАПКА ===== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 30px;
  margin-bottom: 20px;
}

.logo {
  font-size: 32px;
  font-weight: 700;
  color: #00e5ff;
  letter-spacing: 2px;
}

.auth-buttons {
  display: flex;
  gap: 12px;
}

.btn-auth {
  padding: 10px 24px;
  border: none;
  border-radius: 8px;
  background: #00e5ff;
  color: #0a1628;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-auth:hover {
  background: #00b8d4;
}

/* ===== НАВИГАЦИЯ ===== */
.nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 30px;
}

.nav-btn {
  padding: 18px 30px;
  border: none;
  border-radius: 12px;
  background: #00c853;
  color: #0a1628;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 1px;
  cursor: pointer;
  position: relative;
  transition: all 0.2s;
}

.nav-btn:hover {
  background: #00e676;
  transform: translateY(-2px);
}

.nav-btn.active {
  background: #00e676;
  box-shadow: 0 4px 15px rgba(0, 230, 118, 0.4);
}

/* Кружок «О компании» в кнопке КАРТА */
.map-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.info-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #1565c0;
  color: #fff;
  font-size: 18px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s, background 0.2s;
}

.info-circle:hover {
  transform: scale(1.15);
  background: #1976d2;
}

/* ===== РАЗДЕЛЫ ===== */
.section {
  display: none;
  animation: fadeIn 0.4s ease;
}

.section.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.section-header {
  background: #00e5ff;
  padding: 25px 30px;
  border-radius: 12px;
  margin-bottom: 25px;
}

.section-header h2 {
  color: #0a1628;
  font-size: 26px;
  margin-bottom: 6px;
}

.section-subtitle {
  color: #0a1628;
  font-size: 15px;
  opacity: 0.8;
}

/* ===== КАРТОЧКИ СОТРУДНИКОВ ===== */
.employees-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}

.employee-card {
  background: #112240;
  border: 2px solid #1a3a5c;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
  transition: transform 0.2s, border-color 0.2s;
}

.employee-card:hover {
  transform: translateY(-4px);
  border-color: #00e5ff;
}

.employee-photo {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin: 0 auto 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 700;
  color: #fff;
}

.employee-card h3 {
  color: #00e5ff;
  font-size: 18px;
  margin-bottom: 8px;
}

.employee-role {
  color: #76ff03;
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 12px;
}

.employee-desc {
  color: #b0bec5;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 12px;
}

.employee-contact {
  color: #fff;
  font-size: 14px;
}

/* ===== КАРТА И СТАТИСТИКА ===== */
.map-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.russia-map {
  width: 100%;
  max-width: 900px;
  border-radius: 12px;
  border: 2px solid #1a3a5c;
}

.map-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.stat-card {
  background: #ccff00;
  color: #0a1628;
  border-radius: 12px;
  padding: 25px;
  text-align: center;
  transition: transform 0.2s;
}

.stat-card:hover {
  transform: translateY(-4px);
}

.stat-icon {
  font-size: 36px;
  margin-bottom: 10px;
}

.stat-label {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  opacity: 0.8;
}

.stat-value {
  font-size: 24px;
  font-weight: 800;
}

/* ===== КАРТОЧКИ КЛИЕНТОВ ===== */
.clients-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 20px;
}

.client-card {
  background: #112240;
  border: 2px solid #1a3a5c;
  border-radius: 12px;
  padding: 25px;
  transition: transform 0.2s, border-color 0.2s;
}

.client-card:hover {
  transform: translateY(-4px);
  border-color: #ccff00;
}

.client-header {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 12px;
}

.client-avatar {
  width: 55px;
  height: 55px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.client-header h3 {
  color: #00e5ff;
  font-size: 17px;
}

.client-city {
  color: #b0bec5;
  font-size: 13px;
  margin-top: 3px;
}

.client-rating {
  color: #ffeb3b;
  font-size: 18px;
  margin-bottom: 10px;
  letter-spacing: 2px;
}

.client-review {
  color: #e0e0e0;
  font-size: 14px;
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 12px;
}

.client-date {
  color: #78909c;
  font-size: 12px;
  text-align: right;
}

/* ===== МОДАЛЬНОЕ ОКНО ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(10, 22, 40, 0.85);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-overlay.show {
  display: flex;
}

.modal {
  background: #112240;
  border: 2px solid #00e5ff;
  border-radius: 16px;
  padding: 35px;
  max-width: 700px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 15px;
  right: 20px;
  background: none;
  border: none;
  color: #fff;
  font-size: 24px;
  cursor: pointer;
  transition: color 0.2s;
}

.modal-close:hover {
  color: #ff5252;
}

.company-modal-content h2 {
  color: #00e5ff;
  font-size: 26px;
  margin-bottom: 25px;
  padding-bottom: 12px;
  border-bottom: 2px solid #1a3a5c;
}

.company-info-block {
  margin-bottom: 25px;
}

.company-info-block h3 {
  color: #76ff03;
  font-size: 18px;
  margin-bottom: 12px;
}

.company-info-block p {
  color: #e0e0e0;
  font-size: 14px;
  line-height: 1.7;
  margin-bottom: 8px;
}

.company-review {
  background: #0d2137;
  border-left: 3px solid #00e5ff;
  padding: 15px;
  border-radius: 6px;
  margin-bottom: 12px;
}

.company-review strong {
  color: #00e5ff;
}

.company-review .stars {
  color: #ffeb3b;
  margin-left: 8px;
}

.company-review p {
  margin-top: 8px;
  font-style: italic;
}

/* ===== АДАПТИВ ===== */
@media (max-width: 768px) {
  .header {
    flex-direction: column;
    gap: 15px;
    text-align: center;
  }

  .logo {
    font-size: 24px;
  }

  .nav {
    grid-template-columns: 1fr;
  }

  .map-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .clients-grid {
    grid-template-columns: 1fr;
  }
}
