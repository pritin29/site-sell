// ===== РАСЧЁТ МАРШРУТА =====
function calculateRoute() {
    const from = document.getElementById('cityFrom').value;
    const to = document.getElementById('cityTo').value;

    if (from === to) {
        alert('Выберите разные города!');
        return;
    }

    const key1 = `${from}-${to}`;
    const key2 = `${to}-${from}`;
    const distance = distances[key1] || distances[key2] || Math.floor(Math.random() * 3000 + 500);

    const fuelPer100km = 25; // литров на 100 км
    const fuelPrice = 52; // рублей за литр
    const speed = 80; // км/ч

    const fuel = (distance / 100 * fuelPer100km).toFixed(1);
    const cost = Math.round(fuel * fuelPrice);
    const time = (distance / speed).toFixed(1);

    document.getElementById('routeDistance').textContent = `${distance} км`;
    document.getElementById('routeFuel').textContent = `${fuel} л`;
    document.getElementById('routeCost').textContent = `${cost.toLocaleString()} ₽`;
    document.getElementById('routeTime').textContent = `${time} ч`;
    document.getElementById('routeResult').style.display = 'block';

    // Рисуем маршрут на карте
    drawRoute(from, to);
}

function drawRoute(from, to) {
    const start = cityCoords[from];
    const end = cityCoords[to];

    const line = document.getElementById('routeLine');
    const startCircle = document.getElementById('routeStart');
    const endCircle = document.getElementById('routeEnd');

    line.setAttribute('x1', start.x);
    line.setAttribute('y1', start.y);
    line.setAttribute('x2', end.x);
    line.setAttribute('y2', end.y);
    line.style.display = 'block';

    startCircle.setAttribute('cx', start.x);
    startCircle.setAttribute('cy', start.y);
    startCircle.style.display = 'block';

    endCircle.setAttribute('cx', end.x);
    endCircle.setAttribute('cy', end.y);
    endCircle.style.display = 'block';
}

function clearRoute() {
    document.getElementById('routeLine').style.display = 'none';
    document.getElementById('routeStart').style.display = 'none';
    document.getElementById('routeEnd').style.display = 'none';
    document.getElementById('routeResult').style.display = 'none';
}

