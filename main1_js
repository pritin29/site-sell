function calculatePrice() {
    const weight = parseFloat(document.getElementById('calcWeight').value) || 500;
    const tariff = parseFloat(document.getElementById('calcTariff').value) || 1;
    const basePrice = 15000;
    const price = Math.round((basePrice + weight * 30) * tariff);

    document.getElementById('calcPrice').textContent = `${price.toLocaleString()} ₽`;

    const date = new Date();
    const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
                    'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
    document.getElementById('calcDate').textContent = `${date.getDate()} ${months[date.getMonth()]}`;
}

