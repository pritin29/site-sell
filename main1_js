}

// ===== ДЕЙСТВИЯ =====
function doLogin() {
    const email = document.getElementById('loginEmail').value;
    if (email) {
        alert(`Добро пожаловать, ${email}!`);
        closeModalDirect();
    } else {
        alert('Введите email!');
    }
}

function doRegister() {
    const name = document.getElementById('regName').value;
    if (name) {
        alert(`Регистрация успешна! Добро пожаловать, ${name}!`);
        closeModalDirect();
    } else {
        alert('Заполните все поля!');
    }
}

function addEmployee() {
    const name = document.getElementById('empName').value;
    const position = document.getElementById('empPosition').value;
    const phone = document.getElementById('empPhone').value;

    if (name && position) {
        employees.push({
            id: employees.length + 1,
            name,
            position,
            status: 'free',
            phone: phone || 'Не указан'
        });
        renderEmployees();
        closeModalDirect();
        alert('Сотрудник добавлен!');
    } else {
        alert('Заполните обязательные поля!');
    }
}

function addTask() {
    const text = document.getElementById('taskText').value;
    const employee = document.getElementById('taskEmployee').value;
    const priority = document.getElementById('taskPriority').value;

    if (text) {
        tasks.push({ id: tasks.length + 1, text, status: priority, employee });
        renderTasks();
        closeModalDirect();
        alert('Задача назначена!');
    } else {
        alert('Введите описание задачи!');
    }
}

function assignMaterials() {
    const material = document.getElementById('materialType').value;
    const amount = document.getElementById('materialAmount').value;
    const employee = document.getElementById('materialEmployee').value;

    if (amount) {
        alert(`Материал "${material}" (${amount} ед.) назначен сотруднику ${employee}`);
        closeModalDirect();
    } else {
        alert('Укажите количество!');
    }
}

function addClient() {
    const name = document.getElementById('clientName').value;
    const desc = document.getElementById('clientDesc').value;
    const rating = parseInt(document.getElementById('clientRating').value);

    if (name) {
        clients.push({ id: clients.length + 1, name, desc, rating });
        renderClients();
        closeModalDirect();
        alert('Клиент добавлен!');
    } else {
        alert('Введите название клиента!');
    }
}

