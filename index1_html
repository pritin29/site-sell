function calculatePrice() {
    const weight = parseFloat(document.getElementById('calcWeight').value) || 500;
    const tariff = parseFloat(document.getElementById('calcTariff').value) || 1;
    const price = Math.round((15000 + weight * 30) * tariff);
    document.getElementById('calcPrice').textContent = price.toLocaleString('ru') + ' ₽';
    const d = new Date();
    const m = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
    document.getElementById('calcDate').textContent = d.getDate() + ' ' + m[d.getMonth()];
}

