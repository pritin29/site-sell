        <text x="65" y="415" fill="#ccc" font-size="12">Города отправления/назначения</text>

        <line x1="50" y1="430" x2="80" y2="430" stroke="#76FF03" stroke-width="3" stroke-dasharray="6,4"/>
        <text x="90" y="435" fill="#ccc" font-size="12">Маршрут перевозки</text>
      </svg>

      <!-- Блок статистики перевозки -->
