// ===== ОТРИСОВКА ГОРОДОВ НА КАРТЕ =====
function renderMapCities() {
    const g = document.getElementById('cities');
    const svgNS = 'http://www.w3.org/2000/svg';
    g.innerHTML = '';
    Object.entries(cityCoords).forEach(([name, c]) => {
        const circle = document.createElementNS(svgNS, 'circle');
        circle.setAttribute('cx', c.x); circle.setAttribute('cy', c.y);
        circle.setAttribute('r', 7); circle.setAttribute('fill', '#00d4aa');
        circle.classList.add('city');
        circle.addEventListener('click', () => {
            document.getElementById('cityFrom').value = name;
            alert(`Город "${name}" выбран как точка отправления`);
        });
        g.appendChild(circle);
        const text = document.createElementNS(svgNS, 'text');
        text.setAttribute('x', c.x); text.setAttribute('y', c.y - 12);
        text.setAttribute('fill', '#fff'); text.setAttribute('font-size', '11');
        text.setAttribute('text-anchor', 'middle');
        text.textContent = name;
        g.appendChild(text);
    });
}

