// ===== МАРШРУТ =====
function calculateRoute() {
    const from = document.getElementById('cityFrom').value;
    const to = document.getElementById('cityTo').value;
    if (from === to) return alert('Выберите разные города!');

    const key1 = `${from}-${to}`, key2 = `${to}-${from}`;
    const distance = distances[key1] || distances[key2] || Math.floor(Math.random() * 3000 + 500);
    const fuel = (distance / 100 * 25).toFixed(1);
    const cost = Math.round(fuel * 52);
    const time = (distance / 80).toFixed(1);

    document.getElementById('routeDistance').textContent = distance + ' км';
    document.getElementById('routeFuel').textContent = fuel + ' л';
    document.getElementById('routeCost').textContent = cost.toLocaleString('ru') + ' ₽';
    document.getElementById('routeTime').textContent = time + ' ч';
    document.getElementById('routeResult').style.display = 'block';

    const s = cityCoords[from], e = cityCoords[to];
    const line = document.getElementById('routeLine');
    line.setAttribute('x1', s.x); line.setAttribute('y1', s.y);
    line.setAttribute('x2', e.x); line.setAttribute('y2', e.y);
    line.style.display = 'block';
    const sc = document.getElementById('routeStart');
    sc.setAttribute('cx', s.x); sc.setAttribute('cy', s.y); sc.style.display = 'block';
    const ec = document.getElementById('routeEnd');
    ec.setAttribute('cx', e.x); ec.setAttribute('cy', e.y); ec.style.display = 'block';
}

function clearRoute() {
    ['routeLine', 'routeStart', 'routeEnd', 'routeResult'].forEach(id =>
        document.getElementById(id).style.display = 'none');
}

