// ===== ДЕЙСТВИЯ =====
function doLogin() {
    const e = document.getElementById('loginEmail').value;
    if (e) { alert('Добро пожаловать, ' + e + '!'); closeModalDirect(); } else alert('Введите email!');
}
function doRegister() {
    const n = document.getElementById('regName').value;
    if (n) { alert('Регистрация успешна!'); closeModalDirect(); } else alert('Заполните поля!');
}
function addEmployee() {
    const n = document.getElementById('empName').value, p = document.getElementById('empPosition').value;
    if (n && p) {
        employees.push({ id: employees.length + 1, name: n, position: p, status: 'free', phone: document.getElementById('empPhone').value || '—' });
        renderEmployees(); closeModalDirect(); alert('Сотрудник добавлен!');
    } else alert('Заполните ФИО и должность!');
}
function addTask() {
    const t = document.getElementById('taskText').value;
    if (t) {
        tasks.push({ id: tasks.length + 1, text: t, status: document.getElementById('taskPriority').value, employee: document.getElementById('taskEmployee').value });
        renderTasks(); closeModalDirect(); alert('Задача назначена!');
    } else alert('Введите описание!');
}
function assignMaterials() {
    const m = document.getElementById('materialType').value, a = document.getElementById('materialAmount').value;
    if (a) { alert(`${m} (${a}) → ${document.getElementById('materialEmployee').value}`); closeModalDirect(); }
    else alert('Укажите количество!');
}
function addClient() {
    const n = document.getElementById('clientName').value;
    if (n) {
        clients.push({ id: clients.length + 1, name: n, desc: document.getElementById('clientDesc').value, rating: +document.getElementById('clientRating').value });
        renderClients(); closeModalDirect(); alert('Клиент добавлен!');
    } else alert('Введите название!');
}

